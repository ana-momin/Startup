{
  "name": "motion-startup",
  "private": true,
  "version": "0.1.0",
  "description": "Prompt to professional motion graphics. Our own engine, our own IP.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @motion/studio",
    "server": "npm run start --workspace @motion/server",
    "build": "npm run check && npm run build --workspace @motion/studio",
    "preview": "npm run preview --workspace @motion/studio",
    "lint": "npm run lint --workspace @motion/studio",
    "check": "tsc -p apps/server/tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  }
}
